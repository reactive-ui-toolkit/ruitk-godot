# Godot 4 editor cache / import data — regenerated by the editor, machine-specific.
.godot/

# Generated GUITKX output: each Foo.guitkx compiles to a sibling Foo.gd (the Godot editor plugin
# and CI's `--editor --quit` step regenerate them — see addons/reactive_ui_toolkit/plugin.gd). Commit the
# .guitkx source, not the build artifact. The hand-written scripts under examples/ are re-included.
examples/**/*.gd
!examples/app.gd
!examples/demos/signals/signals_store.gd
!examples/demos/styling/styling.style.gd
!examples/demos/context_handle/accent_context.gd
!examples/demos/doom/doom_types.gd
!examples/demos/doom/doom_textures.gd
!examples/demos/doom/doom_maps.gd
!examples/demos/doom/raycast.gd
!examples/demos/doom/game_logic.gd
!examples/demos/doom/doom_game_screen_logic.gd
!examples/demos/doom/doom_bootstrap.gd
!examples/demos/doom/doom_input_state.gd
!examples/demos/doom/doom_bsp.gd
# …and their transient companions: Godot per-script .uid + the compiler's diagnostics sidecars.
examples/**/*.gd.uid
*.guitkx.diags.json

# Bundled ClassDB dump (copied from lsp-server/classdb by bundle-server.js at package time) +
# Godot import sidecars for non-runtime extension assets (icons/logos scanned under res://).
ide-extensions/vscode/classdb/
*.png.import

# Exported builds
/build/
*.tmp

# Test scratch directories (tests/*_test.gd create + clean these up on success; an interrupted or
# crashed run can leave them behind untracked -- never commit the debris).
tests/__*_tmp/

# OS noise
.DS_Store
Thumbs.db

# Publishing secrets (extension marketplace tokens) — never commit
publisher-secrets.json
addons/reactive_ui_toolkit_analyzer/

# This machine's irreducible values (currently just the Godot binary). The family invariant is that
# no TRACKED file names a path existing on only one machine — so the one file that must name them is
# untracked. Copy .ruitk-local.example.json to start; nothing requires the file (see CLAUDE.md
# "Machine-local paths"). Enforced by scripts/check-machine-paths.mjs.
.ruitk-local.json

# Per-machine Claude Code permissions/state: written by the tool, differs per developer, and would
# conflict on every pull. The checked-in .claude/skills/ is shared; this is not.
.claude/settings.local.json

# .vscode/: launch.json + tasks.json ARE tracked (the shared F5 wiring — see .vscode/launch.json).
# Only the machine-generated members are ignored: compile databases and C/C++ properties point at
# this machine's toolchain, and a .code-workspace is one person's window layout.
.vscode/compileCommands_*
.vscode/c_cpp_properties.json
*.code-workspace

# The builder's working roots. Both are transient by design and both clean themselves up, but a
# crashed editor can leave one behind and neither belongs in a commit:
#   the preview MIRROR — the open tree, compiled at scratch paths so the preview cannot compile
#   differently from the build;
#   the provisional home of a tree that has never been saved, which Save re-homes into the folder
#   the user picks.
/__ruitk_builder_preview__~/
/__ruitk_builder_unsaved__~/

# Builder visual gauntlet: the reference shots are committed, ours are regenerated.
/Images/current/
