## Ported from uitkx Samples/Components/StressTest. N bouncing boxes, ALL re-rendered
## every frame via keyed reconciliation, measuring avg FPS — the real throughput test.
import { DemoBox } from "~/examples/demos/demo_box"
import * as DemoStressHooks from "./stress_test.hooks"

export DemoStress() -> RuitkVNode {
  var box_count = useState(300)
  var duration = useState(10.0)
  var count_text = useState("300")
  var dur_text = useState("10")
  var running = useState(false)
  var version = useState(0)
  var area_ref = useRef(null)

  var loop = DemoStressHooks.use_stress_loop(area_ref, box_count[0], duration[0], running[0], version[0], running[1])
  var boxes: Array = loop["boxes"]

  var status := "Stress test — Ready (press Start)"
  if loop["finished"]:
    status = "DONE — %d boxes | Avg FPS: %.1f | %.1fs | Frames: %d" % [boxes.size(), loop["fps"], loop["elapsed"], loop["frames"]]
  elif running[0]:
    status = "Running — %d boxes | FPS: %.1f | %.1f/%.0fs | Frames: %d" % [boxes.size(), loop["fps"], loop["elapsed"], duration[0], loop["frames"]]

  var start := func():
    if running[0]:
      return
    var n := int(count_text[0]) if count_text[0].is_valid_int() else 0
    var d := float(dur_text[0]) if dur_text[0].is_valid_float() else 0.0
    if n > 0 and n <= 10000 and d > 0:
      box_count[1].call(n)
      duration[1].call(d)
      version[1].call(version[0] + 1)
      running[1].call(true)
  return (
    <DemoBox title="Stress test — bouncing boxes (uitkx port)">
      <HBoxContainer style={ {"separation": 8} }>
        <Label text={ status } style={ {"size_flags_horizontal": Control.SIZE_EXPAND_FILL} } />
        <Label text="Boxes:" />
        <LineEdit
          text={ count_text[0] }
          onTextChanged={ func(t): count_text[1].call(t) }
          style={ {"min_width": 70} } />
        <Label text="Secs:" />
        <LineEdit
          text={ dur_text[0] }
          onTextChanged={ func(t): dur_text[1].call(t) }
          style={ {"min_width": 50} } />
        <Button
          text={ "Running…" if running[0] else ("Restart" if loop["finished"] else "Start") }
          onPressed={ start } />
      </HBoxContainer>
      <Control
        ref={ area_ref }
        clip_contents
        style={ {"size_flags_horizontal": Control.SIZE_EXPAND_FILL, "size_flags_vertical": Control.SIZE_EXPAND_FILL, "min_height": 320} }
      >
        @for (b in boxes) {
          return (
            <ColorRect
              key={ b["id"] }
              position={ Vector2(b["x"], b["y"]) }
              size={ Vector2(b["size"], b["size"]) }
              color={ b["color"] } />
          )
        }
      </Control>
    </DemoBox>
  )
}
