## Kind badge tints, indexed by `RuitkBuilderModule.Kind`. A dictionary rather than a match in the
## view: the view asks a question and gets a colour, and adding a kind is one line here.
export kind_tint := {
	0: Color(0.361, 0.588, 0.965),
	1: Color(0.541, 0.831, 0.678),
	2: Color(0.925, 0.706, 0.416),
	3: Color(0.729, 0.678, 0.925),
	4: Color(0.588, 0.780, 0.902),
	5: Color(0.831, 0.647, 0.780),
	6: Color(0.549, 0.549, 0.600),
}
