## The canvas palette and card styles, as a `.style.guitkx` module -- the builder's own UI is
## written in the language the builder edits, so every change to how a card renders goes through
## the same compiler, the same reconciler and the same style system a user's component does.
##
## Kept as one module rather than inlined in the view: a style value that appears in two places
## has to be edited in two places, and the canvas is where "the selected card looks different"
## quietly stops being true for one of them.

export bg := { "bg_color": Color(0.086, 0.086, 0.098) }

export card_box := {
	"bg_color": Color(0.137, 0.137, 0.161),
	"corner_radius_all": 10,
	"border_width_all": 1,
	"border_color": Color(0.188, 0.188, 0.220),
	"content_margin_all": 10,
}

export card_box_selected := {
	"bg_color": Color(0.137, 0.137, 0.161),
	"corner_radius_all": 10,
	"border_width_all": 2,
	"border_color": Color(0.361, 0.588, 0.965),
	"content_margin_all": 10,
}

export card_placeholder := {
	"bg_color": Color(0.137, 0.137, 0.161),
	"corner_radius_all": 10,
	"border_width_all": 1,
	"border_color": Color(0.188, 0.188, 0.220),
}

