
## The builder's canvas, written in `.guitkx` and rendered by the reconciler it is a builder for.
##
## `revision` IS THREADED THROUGH EVERY LEVEL and read by none of them. A card is re-populated IN
## PLACE after an edit -- the same `Card` object, with different rows in it -- so `CanvasCard`'s
## props compare equal to last render's and the reconciler's bailout correctly decides there is
## nothing to do. Correct, and wrong here: the card went on showing the rows it used to have, so
## adding a hook wrote a line into the source pane and put nothing on the card. Passing it to the
## VIEW alone was not enough, because the bailout that mattered was one level down.
##
## DOGFOODED ON PURPOSE. The canvas is the largest, busiest, most re-rendered surface this project
## has, so it is also the strongest test the library gets: every keyed reorder, every bailout,
## every style key the cards use is exercised on every edit, in the editor, by the person building
## the thing. A canvas hand-built out of Control nodes would be easier and would prove nothing.
##
## The view is PURE PRESENTATION. It receives a projected graph and a camera and returns markup;
## it holds no state, mutates nothing, and asks nothing of disk. Every number it measures with
## comes from `RuitkBuilderCanvasMetrics`, so the card the view draws and the card the camera
## measures cannot be different widths.
##
## Everything the view leans on is bound with an inline `preload` IN EACH BODY, never by global
## `class_name` and never as a top-level declaration. A global name resolves through the editor
## class cache, which `ProjectSettings.save()` truncates to whatever the running process loaded.
## A top-level value lowers to a `static var`, whose initialiser had not run by the first render
## -- three "Nil" renders on every open, in the editor only. A `preload` in a body is a
## compile-time constant with no initialisation order at all.
##
## The palette is the one thing here that is NOT `.guitkx`. A generated `.gd` carries no `@tool`,
## and a non-tool script's static vars are never initialised in the editor at all, so a
## `.style.guitkx` module reads back empty from editor code -- silently, every key missing.
## Static FUNCS of a non-tool script do still run, which is why the rest of the canvas stays
## `.guitkx`; only the palette's DATA had to become a hand-written `@tool` script. See
## `canvas_palette.gd`, and `examples/demos/styles/` for the `.style.guitkx` a game would write.

export CanvasView(graph = null, camera = Vector2.ZERO, zoom: float = 1.0,
		viewport = Vector2(1280, 720), selected: int = -1, on_add = null,
		revision: int = 0, selected_row_section: int = -1,
		selected_row_index: int = -1, highlight_names = null) -> RuitkVNode {
	var M = preload("res://addons/reactive_ui_toolkit_editor/builder/canvas/builder_canvas_metrics.gd")
	var lod = M.lod_of(zoom)
	var card_w = M.card_width_for(lod)
	var cards = graph.cards if graph != null else []

	return (
		<Control mouse_filter={ Control.MOUSE_FILTER_IGNORE }>
			@for (i in range(cards.size())) {
				var c = cards[i]
				# One VIEWPORT of slack: a card built only when it crosses the edge appears a
				# frame late during a pan, and the edge painter has no anchor to land on.
				var near = M.is_near_viewport(c, card_w, camera, zoom, viewport)
				# Position is SCREEN space and scale is the zoom, so the card's own contents are
				# laid out once in card-local units whatever the zoom is -- a layout that had to
				# re-measure every label at every zoom would re-wrap text as the user scrolled.
				var pos = M.world_to_screen(Vector2(c.x, c.y), camera, zoom)
				return (
					<CanvasCard key={ c.file_path } card={ c } lod={ lod } index={ i }
						is_selected={ i == selected } at={ pos } zoom={ zoom } near={ near }
						on_add={ on_add } revision={ revision }
						sel_section={ selected_row_section if i == selected else -1 }
						sel_row={ selected_row_index if i == selected else -1 }
						highlight_names={ highlight_names } />
				)
			}
		</Control>
	)
}


## One card: the frame, positioned and scaled, holding either its sections or -- when it is far
## enough outside the viewport not to be worth building -- a plain box of the same height.
##
## A component of its own because the near/far choice is a whole different subtree, and a loop
## body is a code block: the choice has to be made where markup can branch.
##
## THE FAR CARD KEEPS ITS HEADER. An empty rounded rectangle is indistinguishable from a card
## that failed to render, and the reason a distant card is cheap to skip is that its SECTIONS are
## expensive -- its name never was.
##
## (A `#` comment inside a markup block is a TEXT CHILD, not a comment. Two of them in a
## directive body is two roots, and GUITKX0108 says so. Notes about markup live out here.)
export CanvasCard(card = null, lod: int = 1, is_selected: bool = false,
		at = Vector2.ZERO, zoom: float = 1.0, near: bool = true, index: int = -1,
		on_add = null, revision: int = 0, sel_section: int = -1,
		sel_row: int = -1, highlight_names = null) -> RuitkVNode {
	var P = preload("res://addons/reactive_ui_toolkit_editor/builder/canvas/canvas_palette.gd")
	var M = preload("res://addons/reactive_ui_toolkit_editor/builder/canvas/builder_canvas_metrics.gd")
	var card_w = M.card_width_for(lod)

	return (
		@if (near) {
			return (
				<PanelContainer name={ "card-%d" % index } position={ at } scale={ Vector2(zoom, zoom) }
					custom_minimum_size={ Vector2(card_w, 0) } size={ Vector2(card_w, 0) }
					clip_contents={ true }
					mouse_filter={ Control.MOUSE_FILTER_IGNORE }
					style={ P.card_box_selected() if is_selected else P.card_box() }>
					<VBoxContainer style={ {"separation": 4} } mouse_filter={ Control.MOUSE_FILTER_IGNORE }>
						<CanvasCardHeader card={ card } lod={ lod } />
						@if (M.shows_sections(lod)) {
							return (
								<CanvasCardSections card={ card } lod={ lod } index={ index } on_add={ on_add }
				zoom={ zoom } revision={ revision } sel_section={ sel_section } sel_row={ sel_row }
				highlight_names={ highlight_names } />
							)
						}
					</VBoxContainer>
				</PanelContainer>
			)
		} @else {
			# A culled card still occupies its estimated height, so nothing reflows when a pan
			# brings it back.
			return (
				<PanelContainer position={ at } scale={ Vector2(zoom, zoom) }
					custom_minimum_size={ Vector2(card_w, M.card_height(card)) }
					mouse_filter={ Control.MOUSE_FILTER_IGNORE }
					style={ P.card_placeholder() }>
					<MarginContainer style={ {"margin_left": 10, "margin_top": 10, "margin_right": 10} }
							mouse_filter={ Control.MOUSE_FILTER_IGNORE }>
						<CanvasCardHeader card={ card } lod={ lod } />
					</MarginContainer>
				</PanelContainer>
			)
		}
	)
}


## The card's identity row: kind badge, title, and -- at the pill LOD -- nothing else, because a
## pill is what a card looks like when the whole tree is on screen at once.
export CanvasCardHeader(card = null, lod: int = 1) -> RuitkVNode {
	var P = preload("res://addons/reactive_ui_toolkit_editor/builder/canvas/canvas_palette.gd")
	var M = preload("res://addons/reactive_ui_toolkit_editor/builder/canvas/builder_canvas_metrics.gd")
	var Model = preload("res://addons/reactive_ui_toolkit_editor/builder/canvas/builder_graph.gd")
	var tint = P.kind_tint(int(card.kind))

	return (
		<PanelContainer style={ P.card_header_band(tint) } mouse_filter={ Control.MOUSE_FILTER_IGNORE }>
		<HBoxContainer style={ {"separation": 6} } mouse_filter={ Control.MOUSE_FILTER_IGNORE }>
			<PanelContainer style={ P.kind_badge(tint) } mouse_filter={ Control.MOUSE_FILTER_IGNORE }>
				<Label text={ Model.kind_word(int(card.kind)) }
					style={ P.pill_badge_text(tint) if lod == M.Lod.PILL else P.kind_badge_text(tint) } />
			</PanelContainer>
			<Label text={ card.title } style={ P.pill_title() if lod == M.Lod.PILL else P.title() } />
			@if (card.read_only) {
				return (
					<Label text="read-only" style={ P.read_only() } />
				)
			}
		</HBoxContainer>
		</PanelContainer>
	)
}


## Everything below the header: the signature, the import rows, the hook chips, and -- only at the
## full LOD -- the markup tree, the code island and the export detail.
##
## EXPORTS carries "+ style" and not "+ entry": the projection already emits one "+ entry" per
## export, carrying which dictionary it adds to, and a second card-level one would be a button
## that has to guess which. "+ style" adds a whole new export and has nothing to guess about.
export CanvasCardSections(card = null, lod: int = 1, index: int = -1, on_add = null,
		zoom: float = 1.0, revision: int = 0, sel_section: int = -1,
		sel_row: int = -1, highlight_names = null) -> RuitkVNode {
	var P = preload("res://addons/reactive_ui_toolkit_editor/builder/canvas/canvas_palette.gd")
	var M = preload("res://addons/reactive_ui_toolkit_editor/builder/canvas/builder_canvas_metrics.gd")
	# ASKED OF THE ONE PREDICATE the height estimate and the hit-test also ask, so the card cannot
	# draw a different set of sections from the ones the mouse can reach.
	var draws_markup = M.draws_section(M.Section.MARKUP, lod)
	var draws_exports = M.draws_section(M.Section.EXPORTS, lod)
	var draws_island = M.draws_section(M.Section.ISLAND, lod)

	return (
		<VBoxContainer style={ {"separation": 4} } mouse_filter={ Control.MOUSE_FILTER_IGNORE }>
			@if (card.signature != "" and card.kind != 2) {
				return (
					<Label text={ card.signature } style={ P.signature() } clip_text={ true }
						text_overrun_behavior={ TextServer.OVERRUN_TRIM_ELLIPSIS } />
				)
			}
			@if (not card.imports.is_empty()) {
				return (
					<CanvasCardSection heading="IMPORTS">
						@for (i in range(card.imports.size())) {
							var row = card.imports[i]
							return (
								<PanelContainer key={ str(row.at) } name={ "row-1-%d" % i } mouse_filter={ Control.MOUSE_FILTER_IGNORE }
										style={ P.row_selected() if (sel_section == 1 and sel_row == i) else P.row_plain() }>
									<Label text={ row.text } style={ P.import_row() }
										text_overrun_behavior={ TextServer.OVERRUN_TRIM_ELLIPSIS } />
								</PanelContainer>
							)
						}
					</CanvasCardSection>
				)
			}
			@if (card.kind != 2) {
				return (
					<CanvasCardSection heading="BODY — HOOKS & STATE">
						<HFlowContainer style={ {"separation": 4} } mouse_filter={ Control.MOUSE_FILTER_IGNORE }>
							@for (i in range(card.body.size())) {
								var row = card.body[i]
								return (
									<PanelContainer key={ str(row.at) } name={ "row-2-%d" % i } mouse_filter={ Control.MOUSE_FILTER_IGNORE }
											style={ P.row_selected() if (sel_section == 2 and sel_row == i) else P.chip() }>
										<Label text={ row.text } style={ P.chip_text() }
										text_overrun_behavior={ TextServer.OVERRUN_TRIM_ELLIPSIS } />
									</PanelContainer>
								)
							}
							<CanvasAddChip label="+ hook" what="hook" index={ index } on_add={ on_add } />
							<CanvasAddChip label="+ code" what="code" index={ index } on_add={ on_add } />
						</HFlowContainer>
					</CanvasCardSection>
				)
			}
			@if (draws_markup and not card.markup.is_empty()) {
				return (
					<CanvasCardSection heading="RETURN — MARKUP">
						@for (i in range(card.markup.size())) {
							var row = card.markup[i]
							return (
								<PanelContainer key={ str(row.at) } name={ "row-3-%d" % i } mouse_filter={ Control.MOUSE_FILTER_IGNORE }
										style={ P.row_selected() if (sel_section == 3 and sel_row == i) else (P.row_highlighted() if M.row_mentions(row, highlight_names) else P.row_plain()) }>
									<CanvasMarkupRow row={ row } zoom={ zoom } />
								</PanelContainer>
							)
						}
					</CanvasCardSection>
				)
			}
			@if (draws_exports and card.kind == 2) {
				return (
					<CanvasCardSection heading="EXPORTS">
						@for (i in range(card.export_detail.size())) {
							var row = card.export_detail[i]
							return (
								<PanelContainer key={ str(row.at) + row.text } name={ "row-4-%d" % i } mouse_filter={ Control.MOUSE_FILTER_IGNORE }
										style={ P.row_selected() if (sel_section == 4 and sel_row == i) else P.row_plain() }>
									<Label text={ "  ".repeat(row.depth) + row.text } style={ P.export_row() }
										clip_text={ true }
										text_overrun_behavior={ TextServer.OVERRUN_TRIM_ELLIPSIS } />
								</PanelContainer>
							)
						}
						<HFlowContainer style={ {"separation": 4} } mouse_filter={ Control.MOUSE_FILTER_IGNORE }>
							<CanvasAddChip label="+ style" what="style" index={ index } on_add={ on_add } />
						</HFlowContainer>
					</CanvasCardSection>
				)
			}
			@if (draws_island and not card.island_lines.is_empty()) {
				return (
					<CanvasCardSection heading="SETUP">
						@for (i in range(card.island_lines.size())) {
							return (
								<PanelContainer key={ str(i) } name={ "row-5-%d" % i } mouse_filter={ Control.MOUSE_FILTER_IGNORE }
										style={ P.row_selected() if (sel_section == 5 and sel_row == i) else P.row_plain() }>
									<Label text={ card.island_lines[i] } style={ P.island_row() } clip_text={ true }
										text_overrun_behavior={ TextServer.OVERRUN_TRIM_ELLIPSIS } />
								</PanelContainer>
							)
						}
					</CanvasCardSection>
				)
			}
		</VBoxContainer>
	)
}


## A titled group inside a card. Its own component so every section has the same lead, the same
## separation and the same heading treatment -- three places to change it is how two of them stop
## matching.
export CanvasCardSection(heading: String = "") -> RuitkVNode {
	var P = preload("res://addons/reactive_ui_toolkit_editor/builder/canvas/canvas_palette.gd")
	return (
		<VBoxContainer style={ {"separation": 2} } mouse_filter={ Control.MOUSE_FILTER_IGNORE }>
			<ColorRect color={ Color(0.24, 0.24, 0.29, 0.9) }
				custom_minimum_size={ Vector2(0, 1) } />
			<Label text={ heading } style={ P.section_head() } />
			{ children }
		</VBoxContainer>
	)
}


## One row of the markup tree: indented to its depth, coloured by what it is, with its attribute
## run beside it.
export CanvasMarkupRow(row = null, zoom: float = 1.0) -> RuitkVNode {
	var P = preload("res://addons/reactive_ui_toolkit_editor/builder/canvas/canvas_palette.gd")
	var M = preload("res://addons/reactive_ui_toolkit_editor/builder/canvas/builder_canvas_metrics.gd")
	var Model = preload("res://addons/reactive_ui_toolkit_editor/builder/canvas/builder_graph.gd")
	var LineKind = Model.LineKind
	var style = P.markup_row()
	if row.kind == LineKind.COMPONENT:
		style = P.component_row()
	elif row.kind == LineKind.DIRECTIVE:
		style = P.directive_row()

	return (
		<HBoxContainer style={ {"separation": 6} } mouse_filter={ Control.MOUSE_FILTER_IGNORE }>
			<Label text={ "    ".repeat(row.depth) + row.text } style={ style } clip_text={ true }
				text_overrun_behavior={ TextServer.OVERRUN_TRIM_ELLIPSIS }
				size_flags_horizontal={ Control.SIZE_EXPAND_FILL } />
			@if (row.attrs_text != "" and M.shows_attributes(zoom)) {
				return (
					<Label text={ row.attrs_text } style={ P.attrs() } clip_text={ true }
						text_overrun_behavior={ TextServer.OVERRUN_TRIM_ELLIPSIS }
						size_flags_horizontal={ Control.SIZE_SHRINK_END } />
				)
			}
		</HBoxContainer>
	)
}


## One "+" affordance inside a card — the way a hook, a line of setup or a style entry is added
## without leaving the card you are looking at.
##
## A Button rather than a styled Label: it is a button, and a thing that looks like a chip but
## does not take focus, show a hover or answer the keyboard is a thing that only works for people
## using a mouse.
export CanvasAddChip(label: String = "+", what: String = "", index: int = -1,
		on_add = null) -> RuitkVNode {
	var P = preload("res://addons/reactive_ui_toolkit_editor/builder/canvas/canvas_palette.gd")
	var target = index
	var kind = what
	var sink = on_add

	return (
		<Button text={ label } flat={ true } style={ P.add_chip() }
			onPressed={ func(): (sink.call(target, kind) if sink != null else null) } />
	)
}
